# Copy this file to .env for local development or configure the same
# variables in your hosting platform. Never commit a real .env file.

SECRET_KEY=your-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False

# SQLite is the default database for this project and requires no external DB.
# Keep DB_ENGINE unset for SQLite, or explicitly use:
# DB_ENGINE=django.db.backends.sqlite3
# SQLITE_TIMEOUT=30

# Existing MySQL configuration remains supported for future migration:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=ablegod_college_library
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=127.0.0.1
# DB_PORT=3306
