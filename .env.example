# Copy this file to .env for local development or configure the same
# variables in your hosting platform. Never commit a real .env file.

SECRET_KEY=your-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False

# Recommended production database: use DATABASE_URL from your provider.
# Example:
# DATABASE_URL=postgresql://user:password@host:5432/database

# Existing MySQL configuration remains supported:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=ablegod_college_library
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Persistent media storage (S3-compatible) is optional locally but recommended
# in production so uploaded books and exam papers survive redeployments.
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://your-s3-endpoint
# AWS_S3_CUSTOM_DOMAIN=
# AWS_QUERYSTRING_AUTH=True
